# Variables NON secrètes (KEY=value, sans guillemets : kustomize les garderait dans la valeur).
# Secrets : externalsecret.yaml.

# API OpenAI-compatible ; 0.0.0.0 sinon le Service ne joint rien, protégée par API_SERVER_KEY
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_CORS_ORIGINS=https://hermes.lan.wittner.tech

# Dashboard
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119
# redirect_uri OIDC = <public_url>/auth/callback, sans dépendre des en-têtes X-Forwarded-*
HERMES_DASHBOARD_PUBLIC_URL=https://hermes.lan.wittner.tech

# OIDC Authelia : client public + PKCE (clients.yml), pas de secret ; offline_access : refresh token
HERMES_DASHBOARD_OIDC_ISSUER=https://auth.lan.wittner.tech
HERMES_DASHBOARD_OIDC_CLIENT_ID=hermes
HERMES_DASHBOARD_OIDC_SCOPES=openid profile email offline_access
