# Variables d'environnement NON secrètes du conteneur hermes. Injectées via
# `envFrom: configMapRef` sur le ConfigMap généré `hermes-vars` (cf. kustomization.yaml).
#
# Les clés d'API passent par le Secret `hermes-env`, jamais ici — ce fichier est en clair
# dans Git.
#
# Format: KEY=value, une par ligne, SANS guillemets (kustomize les prendrait pour une partie
# de la valeur). Les lignes `#` et vides sont ignorées.

# --- API OpenAI-compatible ---
API_SERVER_ENABLED=true
# Sans 0.0.0.0 le serveur reste sur la loopback du conteneur et le Service ne joint rien.
# La clé (API_SERVER_KEY, dans hermes-env) est ce qui le protège.
API_SERVER_HOST=0.0.0.0
API_SERVER_CORS_ORIGINS=https://hermes.lan.wittner.tech

# --- Dashboard ---
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119
