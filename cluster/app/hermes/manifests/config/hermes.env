# Variables d'environnement NON secrètes du conteneur hermes. Injectées via
# `envFrom: configMapRef` sur le ConfigMap généré `hermes-vars` (cf. kustomization.yaml).
#
# Les clés d'API passent par le Secret `hermes-env`, jamais ici — ce fichier est en clair
# dans Git.
#
# Format: KEY=value, une par ligne, SANS guillemets (kustomize les prendrait pour une partie
# de la valeur). Les lignes `#` et vides sont ignorées.

# --- API OpenAI-compatible ---
API_SERVER_ENABLED=true
# Sans 0.0.0.0 le serveur reste sur la loopback du conteneur et le Service ne joint rien.
# La clé (API_SERVER_KEY, dans hermes-env) est ce qui le protège.
API_SERVER_HOST=0.0.0.0
API_SERVER_CORS_ORIGINS=https://hermes.lan.wittner.tech

# --- Dashboard ---
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119

# --- Installations paresseuses ---
# Vide VOLONTAIREMENT, et c'est ce qui répare le démarrage. L'image pose
# HERMES_DISABLE_LAZY_INSTALLS=1 (venv scellé), mais aussi
# HERMES_LAZY_INSTALL_TARGET=/opt/data/lazy-packages, et tools/lazy_deps.py fait :
#
#     if os.environ.get("HERMES_DISABLE_LAZY_INSTALLS") == "1":
#         return _lazy_install_target() is not None
#
# une cible durable présente ANNULE donc le verrou. Sans cible, ensure() lève
# FeatureUnavailable au lieu de lancer un `uv pip install`.
#
# Pourquoi ça compte : agent/bedrock_adapter.py appelle ensure("provider.bedrock") AU NIVEAU
# MODULE, à l'import, sous un `try/except Exception: pass`. Avec model.provider: "auto" dans le
# config.yaml livré par l'image, cet adaptateur est importé au démarrage, l'installation de
# boto3 ne revient jamais, et la gateway reste figée en `starting` : 8642 ne bind pas, le pod
# ne passe jamais Ready. Un blocage ne lève pas d'exception, le try/except ne protège de rien.
#
# CONTREPARTIE : toute fonctionnalité à dépendance paresseuse (Edge TTS, Firecrawl, Exa,
# certains adaptateurs de plateforme, dépendances de plugins) refusera avec un message explicite
# au lieu de s'installer à la demande. C'est le but : un refus lisible plutôt qu'un gel muet.
HERMES_LAZY_INSTALL_TARGET=
